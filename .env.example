# Environment variables for YarnWrangler

# Database
# PostgreSQL connection string
# For local development, you can use:
# DATABASE_URL="postgresql://username:password@localhost:5432/yarnwrangler?schema=public"
# For production, use your PostgreSQL service URL
DATABASE_URL="postgresql://localhost:5432/yarnwrangler"

# File Upload Configuration
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Upload directory (relative to project root)
UPLOAD_DIR="public/uploads"

# Next.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Development
NODE_ENV="development"